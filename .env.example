# Copy to .env and fill in values.
#   cp .env.example .env
#   openssl rand -hex 32

# Required. Sessions and MCP OAuth tokens are encrypted with this key.
# If it changes, everyone is logged out.
WEBUI_SECRET_KEY=replace-with-openssl-rand-hex-32

# Shown in the UI.
WEBUI_NAME=Qwen Chat

# First account you create becomes admin.
# Later signups stay pending until an admin approves them.
DEFAULT_USER_ROLE=pending
ENABLE_SIGNUP=true
WEBUI_AUTH=true

# Public URL if you put a reverse proxy in front.
# Example: https://chat.example.com
# WEBUI_URL=

# Optional: OpenAI-compatible Qwen endpoint (DashScope, vLLM, etc.)
# OPENAI_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=

# mcpo (optional MCP proxy) shared key. Only used with --profile mcp.
MCPO_API_KEY=change-me-mcpo-key
